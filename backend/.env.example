# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=AnimeStreamer

# Public-facing URL of this backend API (used to build proxy URLs)
# In production, set this to your deployed API domain, e.g.:
# API_BASE_URL=https://api.yourapp.com/api/v1
API_BASE_URL=http://localhost:5000/api/v1

# ─── Database ──────────────────────────────────────────────────────────────────
# For local development (no auth):
MONGODB_URI=mongodb://localhost:27017/anime-streamer
# For Docker with auth (uncomment and fill in):
# MONGODB_URI=mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@mongo:27017/anime-streamer?authSource=admin

# Docker MongoDB credentials (used by docker-compose.yml)
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASSWORD=<generate-a-strong-password>

# ─── Auth (REQUIRED — server will not start without these) ─────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-min-32-chars-change-this
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-this
JWT_REFRESH_EXPIRY=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Streaming Providers ───────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=15000
PROVIDER_RETRY_COUNT=3
CACHE_TTL_SECONDS=1800

# ─── Manga Providers ───────────────────────────────────────────────────────────
# Optional: URL of a self-hosted Mangahook API instance
# Leave blank or remove to disable Mangahook as a provider
MANGAHOOK_API_URL=http://localhost:4000

